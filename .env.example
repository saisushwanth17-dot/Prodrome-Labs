# Prodrome Labs Voice Pipeline Environment Configuration
# Feature Branch: feature/voice-pipeline

# Server-side Credentials (used by sandbox/mock_voice_server.py)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastasia
GROQ_API_KEY=your_groq_api_key_here

# Client-side Credentials (optional direct browser access)
VITE_AZURE_SPEECH_KEY=your_azure_speech_key_here
VITE_AZURE_SPEECH_REGION=eastasia
VITE_GROQ_API_KEY=your_groq_api_key_here

# Local Python WebSocket Sandbox URL
VITE_WS_URL=ws://localhost:8001/ws/voice
